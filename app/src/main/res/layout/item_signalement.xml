<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">



        <!-- Informations -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="#CFD7D7">


            <TextView
                android:id="@+id/txtType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nid-de-poule sur la route"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#263238"/>


            <TextView
                android:id="@+id/txtDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="15/11/2026"
                android:textSize="13sp"
                android:textColor="#777777"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/txtAdresse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📍 Gabès, Rue Habib Bourguiba"
                android:textSize="14sp"
                android:textColor="#246B50"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/txtDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Un grand trou dans la route qui gêne la circulation."
                android:textSize="14sp"
                android:textColor="#555555"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>

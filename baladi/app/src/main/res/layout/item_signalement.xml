<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Photo du problème -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="170dp">

            <ImageView
                android:id="@+id/imgSignalement"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery"
                android:contentDescription="Photo du problème"/>

            <TextView
                android:id="@+id/txtStatut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                android:padding="8dp"
                android:text="En attente"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="#D99A27"/>

        </FrameLayout>

        <!-- Informations -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/txtType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nid-de-poule sur la route"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#263238"/>


            <TextView
                android:id="@+id/txtDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="15/11/2026"
                android:textSize="13sp"
                android:textColor="#777777"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/txtAdresse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📍 Gabès, Rue Habib Bourguiba"
                android:textSize="14sp"
                android:textColor="#246B50"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/txtDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Un grand trou dans la route qui gêne la circulation."
                android:textSize="14sp"
                android:textColor="#555555"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
